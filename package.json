{
  "name": "ttrpg-system",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./systems/dnd5e-2014": {
      "types": "./dist/systems/dnd5e-2014/index.d.ts",
      "import": "./dist/systems/dnd5e-2014/index.js"
    },
    "./systems/dnd5e-2014/system.json": "./dist/systems/dnd5e-2014/system.json",
    "./systems/dnd5e-2014/metadata.json": "./dist/systems/dnd5e-2014/metadata.json"
  },
  "scripts": {
    "start": "npm run ui:dev",
    "lint": "eslint . --max-warnings 0 && npm run lint:css && node --import ./tools/register-alias.mjs tools/lint.mjs",
    "lint:fix": "eslint . --fix --max-warnings 0 && npm run lint:css:fix && node --import ./tools/register-alias.mjs tools/lint.mjs",
    "lint:test": "node --import ./tools/register-alias.mjs tests/lint.test.js",
    "version:test": "node --import ./tools/register-alias.mjs tests/ui-release.test.js",
    "hooks:install": "node --import ./tools/register-alias.mjs tools/install-hooks.mjs",
    "prepare": "npm run hooks:install",
    "build": "tsc -p tsconfig.json && node tools/rewrite-imports.mjs",
    "test": "npm run build && node --import ./tools/register-alias.mjs tests/run-tests.js",
    "test:all": "npm test && npm run test --prefix ui",
    "test:suites": "node --import ./tools/register-alias.mjs tests/run-tests.js --list",
    "test:core": "npm test -- --suite=core",
    "test:systems": "npm test -- --suite=systems",
    "test:content": "npm test -- --suite=content",
    "test:characters": "npm test -- --suite=characters",
    "test:classes": "npm test -- --suite=classes",
    "test:artificer": "npm test -- --suite=artificer",
    "test:tooling": "npm test -- --suite=tooling",
    "demo": "npm run build && node --import ./tools/register-alias.mjs examples/demo.js",
    "demo:dnd2014": "npm run build && node --import ./tools/register-alias.mjs examples/dnd2014-demo.js",
    "templates:build": "npm run build && node --import ./tools/register-alias.mjs tools/build-starter-characters.mjs",
    "ui:dev": "npm run dev --prefix ui",
    "ui:build": "npm run build --prefix ui",
    "test:ui": "npm run build && npm run test --prefix ui",
    "test:ui:components": "npm run build && npm run test:components --prefix ui",
    "test:ui:database": "npm run build && npm run test:database --prefix ui",
    "test:ui:updates": "npm run build && npm run test:updates --prefix ui",
    "test:ui:packages": "npm run build && npm run test:packages --prefix ui",
    "benchmark:loading": "npm run build && node --import ./tools/register-alias.mjs tools/benchmark-loading.mjs",
    "lint:css": "stylelint \"ui/src/**/*.css\" --max-warnings 0 && prettier \"ui/src/**/*.css\" --check",
    "lint:css:fix": "prettier \"ui/src/**/*.css\" --write && stylelint \"ui/src/**/*.css\" --fix && prettier \"ui/src/**/*.css\" --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.4.5",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
