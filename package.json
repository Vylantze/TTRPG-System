{
  "name": "ttrpg-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./systems/dnd5e-2014": {
      "types": "./dist/systems/dnd5e-2014/index.d.ts",
      "import": "./dist/systems/dnd5e-2014/index.js"
    },
    "./systems/dnd5e-2014/system.json": "./dist/systems/dnd5e-2014/system.json",
    "./systems/dnd5e-2014/metadata.json": "./dist/systems/dnd5e-2014/metadata.json"
  },
  "scripts": {
    "lint": "node tools/lint.mjs",
    "lint:test": "node tests/lint.test.js",
    "hooks:install": "node tools/install-hooks.mjs",
    "prepare": "npm run hooks:install",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node tests/run-tests.js",
    "demo": "npm run build && node examples/demo.js",
    "demo:dnd2014": "npm run build && node examples/dnd2014-demo.js",
    "ui:dev": "npm run dev --prefix ui",
    "ui:build": "npm run build --prefix ui",
    "test:ui": "npm run build && npm run test --prefix ui"
  },
  "devDependencies": {
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=22"
  }
}
