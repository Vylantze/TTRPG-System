{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/dist/*": [
        "src/*"
      ],
      "@/*": [
        "*"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ]
}
